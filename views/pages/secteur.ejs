<%- include('../partials/head') %>
<main id="contenu">
  <section class="page-hero page-hero--sector">
    <div class="container page-hero__inner">
      <% if (sector.seo.h1) { %>
      <h1 class="eyebrow eyebrow--icon reveal"><%- icon(sector.icon, { size: 18 }) %><%= sector.seo.h1 %></h1>
      <p class="display display--page reveal"><%= sector.title %></p>
      <% } else { %>
      <p class="eyebrow eyebrow--icon reveal"><%- icon(sector.icon, { size: 18 }) %><%= sector.name %></p>
      <h1 class="display display--page reveal"><%= sector.title %></h1>
      <% } %>
      <% if (sector.intro) { %><p class="lead page-hero__lead reveal"><%= sector.intro %></p><% } %>
      <div class="actions actions--center reveal">
        <a class="btn btn--primary btn--lg" href="/contact?secteur=<%= sector.slug %>"><%= c.cta.buttonLabel %></a>
        <a class="link-arrow link-arrow--lg" href="/offre">Découvrir l’offre<%- icon('chevron-right', { size: 18 }) %></a>
      </div>
    </div>
    <div class="container container--wide">
      <div class="reveal">
        <%- include('../partials/devices', { desktop: sector.image, mobile: sector.mobileImage, alt: sector.imageAlt || `Exemple de site pour ${sector.name.toLowerCase()}`, mobileAlt: sector.mobileImageAlt, eager: true, variant: 'hero' }) %>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="atouts">
    <div class="container split">
      <header class="split__aside">
        <p class="eyebrow reveal">Ton & univers</p>
        <p class="tone reveal"><%= sector.tone %>.</p>
      </header>
      <div>
        <h2 class="h3 reveal" id="atouts"><%= sector.highlightsTitle %></h2>
        <ul class="checklist checklist--large">
          <% for (const item of sector.highlights) { %><li class="reveal"><%- icon('check', { size: 18, strokeWidth: 2.25 }) %><span><%= item %></span></li><% } %>
        </ul>
      </div>
    </div>
  </section>

  <%
    // Fonds alternés (gris clair / blanc) pour les sections présentes.
    let band = 0;
    const bg = () => (band++ % 2 === 0 ? ' section--soft' : '');
  -%>
  <% if (sector.features.length) { %>
  <section class="section<%= bg() %>" aria-labelledby="fonctionnalites">
    <div class="container">
      <h2 class="sr-only" id="fonctionnalites">Fonctionnalités – <%= sector.name %></h2>
      <div class="card-grid">
        <% for (const f of sector.features) { %>
        <div class="card card--white reveal">
          <span class="card__icon"><%- icon(f.icon || 'check', { size: 26 }) %></span>
          <h3 class="h3"><%= f.title %></h3>
          <% if (f.text) { %><p><%= f.text %></p><% } %>
        </div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (sector.journey.length) { %>
  <section class="section<%= bg() %>" aria-labelledby="parcours">
    <div class="container">
      <header class="section-head section-head--center">
        <p class="eyebrow reveal">Côté client</p>
        <h2 class="h2 reveal" id="parcours"><%= sector.journeyTitle || 'Le parcours de vos clients.' %></h2>
      </header>
      <%- include('../partials/journey', { steps: sector.journey }) %>
    </div>
  </section>
  <% } %>

  <% const pf = sector.platform; -%>
  <% if (pf.title && pf.points.length) { %>
  <section class="section<%= bg() %>" aria-labelledby="plateforme">
    <div class="container">
      <header class="section-head section-head--center">
        <% if (pf.eyebrow) { %><p class="eyebrow reveal"><%= pf.eyebrow %></p><% } %>
        <h2 class="h2 reveal" id="plateforme"><%= pf.title %></h2>
        <% if (pf.text) { %><p class="lead reveal"><%= pf.text %></p><% } %>
      </header>
      <ol class="pillars pillars--center">
        <% pf.points.forEach((item, i) => { %>
        <li class="pillar reveal">
          <span class="pillar__num"><%= String(i + 1).padStart(2, '0') %></span>
          <div>
            <h3 class="h4"><%= item.title %></h3>
            <% if (item.text) { %><p><%= item.text %></p><% } %>
          </div>
        </li>
        <% }) %>
      </ol>
    </div>
  </section>
  <% } %>

  <% const ad = sector.admin; -%>
  <% if (ad.title && ad.items.length) { %>
  <section class="section<%= bg() %>" aria-labelledby="gestion">
    <div class="container">
      <header class="section-head section-head--center">
        <% if (ad.eyebrow) { %><p class="eyebrow reveal"><%= ad.eyebrow %></p><% } %>
        <h2 class="h2 reveal" id="gestion"><%= ad.title %></h2>
        <% if (ad.text) { %><p class="lead reveal"><%= ad.text %></p><% } %>
      </header>
      <ul class="checklist checklist--large checklist--center">
        <% for (const item of ad.items) { %><li class="reveal"><%- icon('check', { size: 18, strokeWidth: 2.25 }) %><span><%= item %></span></li><% } %>
      </ul>
    </div>
  </section>
  <% } %>

  <% const pr = sector.process; -%>
  <% if (pr.title && pr.steps.length) { const soft = bg(); %>
  <section class="section<%= soft %>" aria-labelledby="creation">
    <div class="container">
      <header class="section-head section-head--center">
        <% if (pr.eyebrow) { %><p class="eyebrow reveal"><%= pr.eyebrow %></p><% } %>
        <h2 class="h2 reveal" id="creation"><%= pr.title %></h2>
      </header>
      <ol class="card-grid card-grid--steps">
        <% pr.steps.forEach((step, i) => { %>
        <li class="card<%= soft ? ' card--white' : '' %> reveal">
          <span class="step-num"><%= i + 1 %></span>
          <h3 class="h4"><%= step.title %></h3>
          <% if (step.text) { %><p><%= step.text %></p><% } %>
        </li>
        <% }) %>
      </ol>
    </div>
  </section>
  <% } %>

  <% if (projects.length) { %>
  <section class="section<%= bg() %>" aria-labelledby="exemples">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow reveal">Réalisations</p>
        <h2 class="h2 reveal" id="exemples">Un aperçu en images.</h2>
        <a class="link-arrow link-arrow--lg reveal" href="/realisations">Voir toutes les réalisations<%- icon('chevron-right', { size: 18 }) %></a>
      </header>
      <div class="project-grid<%= projects.length === 1 ? ' project-grid--single' : '' %>">
        <% for (const project of projects) { %><%- include('../partials/project-card', { project }) %><% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% const fq = sector.faq; -%>
  <% if (fq.items.length || sector.local) { %>
  <section class="section<%= bg() %>"<% if (fq.items.length) { %> aria-labelledby="questions"<% } %>>
    <div class="container container--narrow">
      <% if (fq.items.length) { %>
      <header class="section-head section-head--center">
        <h2 class="h2 reveal" id="questions"><%= fq.title || 'Questions fréquentes' %></h2>
      </header>
      <div class="faq">
        <% for (const item of fq.items) { %>
        <details class="faq__item reveal">
          <summary><span><%= item.question %></span><span class="faq__icon" aria-hidden="true"><%- icon('plus', { size: 20 }) %></span></summary>
          <div class="faq__answer prose"><%- md(item.answer) %></div>
        </details>
        <% } %>
      </div>
      <% } %>
      <% if (sector.local) { %>
      <p class="note reveal"><%= sector.local %> <a class="link-arrow" href="/creation-site-internet-grenoble">Création de site internet à Grenoble<%- icon('chevron-right', { size: 16 }) %></a></p>
      <% } %>
    </div>
  </section>
  <% } %>

  <section class="section<%= bg() %>" aria-labelledby="autres">
    <div class="container">
      <header class="section-head">
        <h2 class="h2 reveal" id="autres">Les autres secteurs.</h2>
      </header>
      <div class="sector-grid sector-grid--three">
        <% for (const other of others) { %><%- include('../partials/sector-card', { sector: other }) %><% } %>
      </div>
    </div>
  </section>

  <%- include('../partials/cta', { ctaHref: `/contact?secteur=${sector.slug}` }) %>
</main>
<%- include('../partials/lightbox') %>
<%- include('../partials/footer') %>
