<% if (c.site.logo) { %><img class="logo__img" src="<%= c.site.logo %>" alt="<%= c.site.name %>"><% } else { %><svg class="logo__mark" width="26" height="26" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="1" y="1" width="30" height="30" rx="9" fill="currentColor"/><rect x="15" y="15" width="11" height="11" rx="3.4" class="logo__dot"/></svg><span class="logo__word"><%= c.site.name %></span><% } %>
