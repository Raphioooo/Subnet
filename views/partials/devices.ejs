<div class="devices<%= locals.variant ? ' devices--' + variant : '' %>">
  <div class="browser">
    <div class="browser__bar" aria-hidden="true"><span class="browser__dots"><i></i><i></i><i></i></span><span class="browser__address"><%- icon('lock', { size: 11, strokeWidth: 2.25 }) %></span></div>
    <div class="browser__screen">
      <img <%- imgSrc(desktop, 1600, '(max-width: 640px) 92vw, (max-width: 1100px) 80vw, 1000px') %> alt="<%= alt %>" width="1600" height="1000" loading="<%= locals.eager ? 'eager' : 'lazy' %>" decoding="async"<% if (locals.eager) { %> fetchpriority="high"<% } %>>
    </div>
  </div>
  <% if (locals.mobile) { %>
  <div class="phone" aria-hidden="true">
    <div class="phone__screen"><img <%- imgSrc(mobile, 600, '(max-width: 640px) 30vw, 200px') %> alt="<%= locals.mobileAlt || '' %>" width="600" height="1300" loading="lazy" decoding="async"></div>
  </div>
  <% } %>
</div>
