<article class="project-card reveal" data-project data-sector="<%= project.sector %>">
  <button class="project-card__media" type="button" data-lightbox
    data-src="<%= project.image %>" data-title="<%= project.title %>" data-text="<%= project.description %>"
    data-url="<%= project.url %>" data-badge="<%= project.badge %>" data-sector-label="<%= sectorLabel(project.sector) %>"
    data-mobile="<%= project.mobileImage %>" aria-label="Agrandir : <%= project.title %>">
    <img src="<%= project.image %>" alt="<%= project.title %>, aperçu du site sur ordinateur" loading="lazy" decoding="async" width="1600" height="1000">
    <% if (project.mobileImage) { %><span class="project-card__phone" aria-hidden="true"><img src="<%= project.mobileImage %>" alt="<%= project.title %>, aperçu du site sur mobile" loading="lazy" decoding="async" width="600" height="1300"></span><% } %>
  </button>
  <div class="project-card__body">
    <p class="project-card__meta">
      <% if (project.badge) { %><span class="badge"><%= project.badge %></span><% } %>
      <span><%= sectorLabel(project.sector) %></span>
    </p>
    <h3 class="h4"><%= project.title %></h3>
    <% if (project.description) { %><p><%= project.description %></p><% } %>
    <% if (project.url) { %><a class="link-arrow" href="<%= project.url %>" target="_blank" rel="noopener noreferrer">Voir le site<%- icon('arrow-up-right', { size: 16 }) %></a><% } %>
  </div>
</article>
