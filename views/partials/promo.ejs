<% const pr = c.home.promo; if (pr.enabled && pr.title && isRunning(pr.until)) { -%>
<section class="section section--dark promo" id="offre-du-moment" aria-labelledby="promo-titre">
  <div class="container promo__inner">
    <header class="section-head section-head--center">
      <% if (pr.badge) { %><p class="promo__badge reveal"><%= pr.badge %></p><% } %>
      <h2 class="h2 reveal" id="promo-titre"><%= pr.title %></h2>
      <% if (pr.text) { %><p class="lead reveal"><%= pr.text %></p><% } %>
    </header>
    <% if (pr.steps.length) { %>
    <ol class="promo__steps reveal">
      <% pr.steps.forEach((step, i) => { %><li><span class="promo__num"><%= i + 1 %></span><span><%= step %></span></li><% }) %>
    </ol>
    <% } %>
    <% if (pr.note) { %><p class="promo__note reveal"><%= pr.note %></p><% } %>
    <% if (pr.linkLabel && pr.link) { %><div class="actions actions--center reveal"><a class="btn btn--light btn--lg" href="<%= pr.link %>"><%= pr.linkLabel %></a></div><% } %>
  </div>
</section>
<% } -%>
