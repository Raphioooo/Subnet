<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="logo" href="/" aria-label="<%= c.site.name %>, accueil"><%- include('logo') %></a>
    <nav class="site-nav" aria-label="Navigation principale">
      <ul>
        <% for (const item of nav) { %>
        <li><a href="<%= item.href %>"<% if (currentPath === item.href || currentPath.startsWith(item.href + '/')) { %> aria-current="page"<% } %>><%= item.label %></a></li>
        <% } %>
      </ul>
    </nav>
    <a class="btn btn--primary btn--sm site-header__cta" href="<%= c.cta.buttonLink %>"><%= c.cta.buttonLabel %></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-mobile" data-menu-toggle>
      <span class="sr-only">Ouvrir le menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>
  <div class="mobile-menu" id="menu-mobile" data-menu hidden>
    <nav aria-label="Navigation mobile">
      <ul>
        <li><a href="/">Accueil</a></li>
        <% for (const item of nav) { %>
        <li><a href="<%= item.href %>"<% if (currentPath === item.href || currentPath.startsWith(item.href + '/')) { %> aria-current="page"<% } %>><%= item.label %></a></li>
        <% } %>
      </ul>
      <a class="btn btn--primary btn--lg" href="<%= c.cta.buttonLink %>"><%= c.cta.buttonLabel %></a>
    </nav>
  </div>
</header>
