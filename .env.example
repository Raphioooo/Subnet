# Copiez ce fichier en .env puis adaptez les valeurs.

# Port d'écoute du serveur
PORT=3000

# Environnement : production en ligne, development en local
NODE_ENV=production

# Mot de passe de l'espace d'administration (/admin).
# S'il est vide, un mot de passe temporaire est généré au premier démarrage
# et affiché dans la console ; vous pourrez ensuite le changer depuis l'admin.
ADMIN_PASSWORD=

# Clé secrète pour signer les sessions (64 caractères aléatoires conseillés).
# Si elle est vide, une clé est générée et conservée dans le dossier de données.
SESSION_SECRET=

# Dossier où sont stockés les contenus, messages et images envoyées.
# Sur un hébergement avec disque persistant, pointez-le vers ce disque.
DATA_DIR=./data

# Adresse publique du site (pour le référencement : sitemap, liens canoniques).
# Peut aussi être renseignée dans l'admin (Général > Adresse du site).
BASE_URL=

# Proxies de confiance (reverse proxy Nginx, hébergeur PaaS…).
# Valeurs possibles : true, false, un nombre de proxies, ou une liste d'adresses.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Notification par email des nouveaux messages (optionnel).
# Sans SMTP_HOST, les messages restent consultables dans l'admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Expéditeur des notifications (par défaut : SMTP_USER)
MAIL_FROM=
# Destinataire des notifications (par défaut : l'email de contact saisi dans l'admin)
MAIL_TO=
