# Le domaine vient de la variable DOMAIN du fichier .env (ex. mondomaine.fr).
# Caddy obtient et renouvelle seul les certificats HTTPS.

{$DOMAIN} {
	reverse_proxy site:3000
}

# Les visiteurs de www.mondomaine.fr, en http comme en https, sont redirigés
# en une seule fois vers https://mondomaine.fr (sans étape intermédiaire).
www.{$DOMAIN}, http://www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
